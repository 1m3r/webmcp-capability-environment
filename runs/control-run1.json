    "html": "\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap');\n\n  :root {\n    --ink: oklch(17% 0.022 54);\n    --cream: oklch(94% 0.035 78);\n    --cream-soft: oklch(88% 0.03 76);\n    --ember: oklch(68% 0.185 46);\n    --ember-deep: oklch(54% 0.18 42);\n    --line: oklch(91% 0.035 78 / 0.28);\n    --micro: 150ms;\n    --standard: 260ms;\n    --cinematic: 980ms;\n    --ease-snap: cubic-bezier(0.22, 1, 0.36, 1);\n    --ease-reveal: cubic-bezier(0.32, 0.72, 0, 1);\n    --ease-drift: cubic-bezier(0.45, 0, 0.18, 1);\n  }\n\n  * { box-sizing: border-box; }\n\n  html, body {\n    margin: 0;\n    min-height: 100%;\n    background: var(--ink);\n  }\n\n  body {\n    font-family: \"DM Sans\", sans-serif;\n    color: var(--cream);\n  }\n\n  .roaster-hero {\n    container-type: inline-size;\n    position: relative;\n    min-height: 100svh;\n    overflow: clip;\n    contain: paint;\n    isolation: isolate;\n    background: var(--ink);\n  }\n\n  .hero-photo-frame,\n  .hero-photo,\n  .hero-wash,\n  .grain {\n    position: absolute;\n    inset: 0;\n  }\n\n  .hero-photo-frame {\n    overflow: clip;\n    z-index: -4;\n  }\n\n  .hero-photo {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: 58% 50%;\n    filter: saturate(.72) contrast(1.08) brightness(.67);\n    transform: scale(1.055);\n    animation: photo-drift 14s var(--ease-drift) both;\n    z-index: 0;\n  }\n\n  .hero-wash {\n    z-index: -3;\n    background:\n      linear-gradient(90deg, oklch(13% 0.025 45 / .92) 0%, oklch(15% 0.022 45 / .66) 42%, transparent 76%),\n      linear-gradient(180deg, oklch(10% 0.018 50 / .56) 0%, transparent 35%, oklch(10% 0.018 50 / .68) 100%);\n  }\n\n  .grain {\n    z-index: -2;\n    pointer-events: none;\n    opacity: .13;\n    mix-blend-mode: soft-light;\n    background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.55'/%3E%3C/svg%3E\");\n  }\n\n  .topbar {\n    position: relative;\n    z-index: 5;\n    display: grid;\n    grid-template-columns: 1fr auto 1fr;\n    align-items: center;\n    min-height: 84px;\n    padding: 0 clamp(22px, 4vw, 64px);\n    border-bottom: 1px solid var(--line);\n    opacity: 0;\n    transform: translateY(-14px);\n    animation: enter-down var(--cinematic) var(--ease-reveal) 120ms forwards;\n  }\n\n  .monogram {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    color: var(--cream);\n    text-decoration: none;\n    width: max-content;\n    min-height: 44px;\n    font-size: 12px;\n    font-weight: 600;\n    letter-spacing: .18em;\n    text-transform: uppercase;\n    transition: opacity var(--micro) var(--ease-snap), transform var(--micro) var(--ease-snap);\n  }\n\n  .monogram-mark {\n    width: 28px;\n    height: 28px;\n    border: 1px solid var(--line);\n    border-radius: 50%;\n    display: grid;\n    place-items: center;\n    font-family: \"Instrument Serif\", serif;\n    font-size: 16px;\n    font-style: italic;\n  }\n\n  .nav {\n    display: flex;\n    align-items: center;\n    gap: clamp(22px, 3vw, 46px);\n  }\n\n  .nav a {\n    position: relative;\n    display: inline-flex;\n    align-items: center;\n    min-height: 44px;\n    color: var(--cream-soft);\n    text-decoration: none;\n    font-size: 12px;\n    letter-spacing: .12em;\n    text-transform: uppercase;\n    transition: color var(--micro) var(--ease-snap), transform var(--micro) var(--ease-snap);\n  }\n\n  .nav a::after {\n    content: \"\";\n    position: absolute;\n    left: 0;\n    right: 0;\n    bottom: 8px;\n    height: 1px;\n    background: var(--ember);\n    transform: scaleX(0);\n    transform-origin: right;\n    transition: transform var(--standard) var(--ease-snap);\n  }\n\n  .bag-link {\n    justify-self: end;\n    display: inline-flex;\n    align-items: center;\n    gap: 12px;\n    min-height: 44px;\n    min-width: 44px;\n    color: var(--cream);\n    text-decoration: none;\n    font-size: 12px;\n    letter-spacing: .12em;\n    text-transform: uppercase;\n    transition: color var(--micro) var(--ease-snap), transform var(--micro) var(--ease-snap);\n  }\n\n  .bag-count {\n    display: grid;\n    place-items: center;\n    width: 26px;\n    height: 26px;\n    border-radius: 50%;\n    background: var(--ember);\n    color: var(--ink);\n    font-weight: 600;\n  }\n\n  .hero-body {\n    position: relative;\n    z-index: 2;\n    display: grid;\n    grid-template-columns: minmax(0, 1.32fr) minmax(240px, .68fr);\n    align-items: end;\n    min-height: calc(100svh - 84px);\n    padding: clamp(64px, 11vh, 124px) clamp(22px, 4vw, 64px) clamp(26px, 5vh, 58px);\n  }\n\n  .hero-copy {\n    align-self: center;\n    max-width: 980px;\n  }\n\n  .eyebrow {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    margin: 0 0 clamp(20px, 3vh, 34px);\n    color: var(--cream-soft);\n    font-size: 11px;\n    font-weight: 600;\n    letter-spacing: .2em;\n    text-transform: uppercase;\n    opacity: 0;\n    transform: translateY(18px);\n    animation: enter-up 720ms var(--ease-reveal) 260ms forwards;\n  }\n\n  .eyebrow::before {\n    content: \"\";\n    width: 44px;\n    height: 1px;\n    background: var(--ember);\n  }\n\n  .brand {\n    margin: 0;\n    color: var(--cream);\n    max-width: 10ch;\n    font-family: \"Instrument Serif\", serif;\n    font-size: clamp(78px, 11.7vw, 188px);\n    font-weight: 400;\n    line-height: .72;\n    letter-spacing: -.055em;\n    text-wrap: balance;\n  }\n\n  .brand-line {\n    display: block;\n    opacity: 0;\n    transform: translateY(70px);\n    animation: brand-rise var(--cinematic) var(--ease-reveal) forwards;\n  }\n\n  .brand-line:first-child { animation-delay: 330ms; }\n  .brand-line:last-child {\n    color: var(--ember);\n    font-style: italic;\n    padding-left: .43em;\n    animation-delay: 410ms;\n  }\n\n  .promise-row {\n    display: grid;\n    grid-template-columns: minmax(240px, 480px) auto;\n    gap: 38px;\n    align-items: end;\n    margin-top: clamp(34px, 6vh, 70px);\n    max-width: 780px;\n    opacity: 0;\n    transform: translateY(22px);\n    animation: enter-up 780ms var(--ease-reveal) 620ms forwards;\n  }\n\n  .promise {\n    margin: 0;\n    color: var(--cream-soft);\n    font-size: clamp(15px, 1.25vw, 19px);\n    line-height: 1.55;\n    text-wrap: pretty;\n  }\n\n  .cta {\n    position: relative;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 14px;\n    min-width: 174px;\n    min-height: 54px;\n    padding: 0 22px;\n    overflow: hidden;\n    background: var(--ember);\n    color: var(--ink);\n    text-decoration: none;\n    font-size: 12px;\n    font-weight: 600;\n    letter-spacing: .13em;\n    text-transform: uppercase;\n    transition: transform var(--micro) var(--ease-snap), color var(--micro) var(--ease-snap), background-color var(--standard) var(--ease-reveal);\n  }\n\n  .cta::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background: var(--cream);\n    transform: translateX(-102%);\n    transition: transform var(--standard) var(--ease-snap);\n    z-index: -1;\n  }\n\n  .cta-arrow {\n    font-size: 18px;\n    line-height: 1;\n    transition: transform var(--standard) var(--ease-snap);\n  }\n\n  .origin-note {\n    justify-self: end;\n    width: min(100%, 280px);\n    padding-top: 20px;\n    border-top: 1px solid var(--line);\n    opacity: 0;\n    transform: translateY(22px);\n    animation: enter-up 800ms var(--ease-reveal) 720ms forwards;\n  }\n\n  .origin-index {\n    display: flex;\n    justify-content: space-between;\n    margin-bottom: 48px;\n    color: var(--cream-soft);\n    font-size: 10px;\n    letter-spacing: .18em;\n    text-transform: uppercase;\n  }\n\n  .origin-note h2 {\n    margin: 0 0 12px;\n    max-width: 9ch;\n    font-family: \"Instrument Serif\", serif;\n    font-size: clamp(28px, 3vw, 46px);\n    font-weight: 400;\n    line-height: .95;\n  }\n\n  .origin-note p {\n    margin: 0;\n    color: var(--cream-soft);\n    font-size: 12px;\n    line-height: 1.55;\n  }\n\n  .roast-seal {\n    position: absolute;\n    right: clamp(20px, 4vw, 64px);\n    top: 116px;\n    width: 116px;\n    aspect-ratio: 1;\n    border: 1px solid var(--line);\n    border-radius: 50%;\n    display: grid;\n    place-items: center;\n    opacity: 0;\n    transform: scale(.82) rotate(-12deg);\n    animation: seal-in 860ms var(--ease-snap) 820ms forwards;\n  }\n\n  .roast-seal::before {\n    content: \"\";\n    width: 68px;\n    aspect-ratio: 1;\n    border-radius: 50%;\n    background: var(--ember);\n    opacity: .84;\n  }\n\n  .roast-seal span {\n    position: absolute;\n    font-size: 9px;\n    font-weight: 600;\n    letter-spacing: .16em;\n    text-transform: uppercase;\n  }\n\n  .roast-seal .top { top: 13px; }\n  .roast-seal .bottom { bottom: 13px; transform: rotate(180deg); }\n\n  @media (hover: hover) {\n    .monogram:hover,\n    .bag-link:hover { opacity: .72; transform: translateY(-2px); }\n    .nav a:hover { color: var(--cream); transform: translateY(-2px); }\n    .nav a:hover::after { transform: scaleX(1); transform-origin: left; }\n    .cta:hover { transform: translateY(-3px); background: transparent; }\n    .cta:hover::before { transform: translateX(0); }\n    .cta:hover .cta-arrow { transform: translateX(5px); }\n  }\n\n  .monogram:focus-visible,\n  .nav a:focus-visible,\n  .bag-link:focus-visible,\n  .cta:focus-visible {\n    outline: 2px solid var(--ember);\n    outline-offset: 4px;\n  }\n\n  .monogram:active,\n  .nav a:active,\n  .bag-link:active,\n  .cta:active {\n    transform: translateY(1px) scale(.98);\n  }\n\n  @keyframes enter-down {\n    to { opacity: 1; transform: translateY(0); }\n  }\n\n  @keyframes enter-up {\n    to