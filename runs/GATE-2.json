    "html": "<section class=\"coffee-stage\" aria-label=\"Coffee subscription pricing\"><article class=\"subscription-card\" data-pricing-card=\"\"><div class=\"card-topline\"><div class=\"roast-mark\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" role=\"img\"><path d=\"M18.8 3.7C14.9 1.5 9.2 3.2 6 7.3c-3.3 4.2-3 9.6.6 12.1 3.7 2.5 9.4.6 12.3-3.7 2.8-4.3 3.7-9.7-.1-12Zm-1.2 1.8c-1.1 2.7-2.8 4.3-5.1 5.8-2.1 1.4-3.6 3.2-4.3 5.8-1.8-1.8-1.6-5.3.7-8.2 2.3-3 6-4.5 8.7-3.4Z\"></path></svg></div><p class=\"eyebrow\">Morrow Coffee · Roast 02</p><span class=\"availability\">Ships weekly</span></div><div class=\"offer\"><p class=\"kicker\">House subscription</p><h1>Good coffee,<br><em>on repeat.</em></h1><p class=\"description\">A rotating single-origin roast, selected for sweetness and delivered at peak freshness.</p></div><div class=\"price-row\"><div class=\"price\"><span class=\"currency\">€</span><strong>24</strong><span class=\"cadence\">/ month</span></div><p class=\"bag-note\">2 × 250g bags<br>Cancel anytime</p></div><ul class=\"benefits\" aria-label=\"Subscription benefits\"><li><span>01</span><p>Roasted every Monday</p></li><li><span>02</span><p>Free tracked delivery</p></li><li><span>03</span><p>Brew guide in every box</p></li></ul><div class=\"actions\"><button class=\"action action-primary\" type=\"button\">Subscribe now <span aria-hidden=\"true\">↗</span></button><button class=\"action action-secondary\" type=\"button\">View roast details</button></div><p class=\"fine-print\">Pause, skip, or cancel before your next roast day.</p></article></section><style>\n@media (prefers-reduced-motion: reduce) {\n  * { transition: none !important; animation: auto ease 0s 1 normal none running none !important; }\n}\n.coffee-stage { --ink: oklch(16% 0.018 50); --paper: oklch(93% 0.026 78); --ember: oklch(70% 0.18 48); --ease-reveal: cubic-bezier(.32,.72,0,1); --ease-hover: cubic-bezier(.22,1,.36,1); --ease-press: cubic-bezier(.2,.8,.2,1); --dur-micro: 160ms; --dur-standard: 260ms; --dur-reveal: 700ms; box-sizing: border-box; container: coffee-card / inline-size; display: grid; place-items: center; min-height: 100%; padding: 42px; background: var(--paper); color: var(--paper); font-family: \"Avenir Next\", \"Helvetica Neue\", sans-serif; overflow: clip; }\n.coffee-stage * { box-sizing: border-box; }\n.subscription-card { position: relative; width: min(100%, 434px); padding: 42px; border-radius: 13px; background: var(--ink); box-shadow: oklch(0.16 0.018 50 / 0.28) 0px 28px 70px; overflow: hidden; isolation: isolate; animation: card-arrive var(--dur-reveal) var(--ease-reveal) both; }\n.subscription-card::before { content: \"\"; position: absolute; inset: 14px; border: 1px solid oklch(0.93 0.026 78 / 0.14); border-radius: 7px; pointer-events: none; }\n.card-topline { display: grid; grid-template-columns: 49px 1fr auto; align-items: center; gap: 14px; padding-bottom: 28px; border-bottom: 1px solid oklch(0.93 0.026 78 / 0.18); }\n.roast-mark { display: grid; place-items: center; width: 49px; height: 49px; border: 1px solid var(--ember); border-radius: 49px; color: var(--ember); }\n.roast-mark svg { width: 21px; height: 21px; fill: currentcolor; }\n.eyebrow, .availability, .kicker, .description, .bag-note, .benefits p, .fine-print { margin: 0px; }\n.eyebrow, .availability, .kicker, .bag-note, .benefits, .fine-print { text-transform: uppercase; letter-spacing: 0.12em; }\n.eyebrow { font-size: 10px; font-weight: 700; }\n.offer { display: grid; gap: 21px; padding-block: 42px 35px; }\n.offer h1 { margin: 0px; max-width: 350px; font-family: \"Iowan Old Style\", \"Palatino Linotype\", \"Book Antiqua\", Palatino, serif; font-size: clamp(46px, 13cqi, 68px); font-weight: 400; line-height: 0.88; letter-spacing: -0.045em; text-wrap: balance; }\n.offer h1 em { color: var(--ember); font-weight: 400; }\n.price-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 21px; padding-block: 28px; border-block: 1px solid oklch(0.93 0.026 78 / 0.18); }\n.benefits { display: grid; gap: 0px; margin: 0px; padding: 21px 0px 28px; list-style: none; }\n.benefits li { display: grid; grid-template-columns: 35px 1fr; align-items: center; gap: 14px; min-height: 42px; border-bottom: 1px solid oklch(0.93 0.026 78 / 0.1); }\n.benefits li:last-child { border-bottom: 0px; }\n.benefits span { font-size: 9px; color: var(--ember); }\n.benefits p { font-size: 10px; font-weight: 700; }\n.actions { display: grid; gap: 14px; }\n.action { display: flex; align-items: center; justify-content: space-between; width: 100%; height: 49px; padding-inline: 21px; border: 1px solid var(--paper); border-radius: 13px; font: 700 11px / 1 \"Avenir Next\", \"Helvetica Neue\", sans-serif; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; transition: transform var(--dur-micro) var(--ease-press),opacity var(--dur-standard) var(--ease-hover),background-color var(--dur-standard) var(--ease-hover),color var(--dur-micro) var(--ease-press); }\n.action-primary { border-color: var(--ember); background: var(--ember); color: var(--ink); }\n.action-secondary { justify-content: center; background: oklch(0.16 0.018 50 / 0); color: var(--paper); }\n.action:focus-visible { outline: 3px solid var(--ember); outline-offset: 3px; }\n.action:active { transform: translateY(1px) scale(0.985); }\n.action:disabled, .action[aria-disabled=\"true\"] { cursor: not-allowed; opacity: 0.4; }\n.fine-print { padding-top: 21px; font-size: 8px; line-height: 1.5; text-align: center; color: oklch(0.93 0.026 78 / 0.44); }\n@media (hover: hover) {\n  .action-primary:hover { transform: translateY(-2px); opacity: 0.9; }\n  .action-secondary:hover { transform: translateY(-2px); background: oklch(0.93 0.026 78 / 0.08); color: var(--ember); }\n}\n@container coffee-card (max-width: 480px) {\n  .coffee-stage { padding: 21px; }\n  .subscription-card { padding: 28px; }\n  .card-topline { grid-template-columns: 42px 1fr; }\n  .roast-mark { width: 42px; height: 42px; }\n  .availability { display: none; }\n  .offer { padding-block: 35px 28px; }\n  .offer h1 { font-size: 49px; }\n  .description { font-size: 13px; }\n  .price strong { font-size: 56px; }\n}\n@keyframes card-arrive { \n  0% { opacity: 0; transform: translateY(21px) scale(0.98); }\n  100% { opacity: 1; transform: translateY(0px) scale(1); }\n}\n@media (prefers-reduced-motion: reduce) {\n  .coffee-stage *, .coffee-stage ::before, .coffee-stage ::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; transition-duration: 0.01ms !important; }\n}\n.subscription-card { width: min(100%, 560px); display: grid; grid-template-columns: 1fr 1fr; grid-template-areas: \"top top\" \"offer offer\" \"price benefits\" \"actions actions\" \"fine fine\"; column-gap: 28px; padding: 28px; }\n.card-topline { grid-area: top; padding-bottom: 21px; }\n.offer { grid-area: offer; gap: 14px; padding-block: 28px; }\n.offer h1 { max-width: 490px; font-size: 63px; line-height: 0.86; }\n.price-row { grid-area: price; flex-direction: column; align-items: flex-start; justify-content: flex-start; gap: 21px; padding-block: 21px; }\n.benefits { grid-area: benefits; padding: 21px 0px; }\n.actions { grid-area: actions; }\n.fine-print { grid-area: fine; }\n@container coffee-card (max-width: 480px) {\n  .subscription-card { display: grid; grid-template-columns: 1fr; grid-template-areas: \"top\" \"offer\" \"price\" \"benefits\" \"actions\" \"fine\"; column-gap: 0px; padding: 28px; }\n  .offer { padding-block: 35px 28px; }\n  .offer h1 { font-size: 49px; }\n  .price-row { flex-direction: row; align-items: flex-end; justify-content: space-between; }\n  .bag-note { text-align: right; }\n}\n@container coffee-card (max-width: 480px) {\n  .coffee-stage { padding: 14px; }\n  .subscription-card { padding: 21px; }\n  .subscription-card::before { inset: 7px; }\n  .card-topline { grid-template-columns: 35px 1fr; gap: 14px; padding-bottom: 14px; }\n  .roast-mark { width: 35px; height: 35px; }\n  .roast-mark svg { width: 14px; height: 14px; }\n  .eyebrow { font-size: 9px; line-height: 1.45; }\n  .offer { gap: 14px; padding-block: 21px; }\n  .offer h1 { font-size: 42px; line-height: 0.9; }\n  .description { font-size: 12px; }\n  .price-row { flex-direction: column; align-items: flex-start; gap: 14px; padding-block: 14px; }\n  .bag-note { text-align: left; }\n  .benefits { padding: 14px 0px; }\n  .benefits li { grid-template-columns: 28px 1fr; gap: 7px; min-height: 35px; }\n  .benefits p { font-size: 9px; line-height: 1.4; }\n  .action { padding-inline: 14px; font-size: 10px; }\n  .fine-print { padding-top: 14px; font-size: 7px; }\n}\n.action{height:84px;border-radius:20px}.actions{gap:21px}.subscription-card{border-radius:20px}</style>"
